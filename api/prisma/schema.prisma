generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model cursos {
  id       Int          @id @default(autoincrement())
  sigla    String       @db.VarChar(10)
  ano      Int
  nome     String       @db.VarChar(100)
  periodo  periodo_enum
  projetos projetos[]
  usuarios usuarios[]
}

model usuario {
  id                                                  Int            @id @default(autoincrement())
  rm                                                  String         @unique @db.VarChar(20)
  nome                                                String         @db.VarChar(100)
  curso_id                                            Int
  email                                               String         @unique @db.VarChar(255)
  senha                                               String         @db.VarChar(255)
  telefone                                            String?        @db.VarChar(20)
  data_nascimento                                     DateTime?      @db.Date
  data_criacao                                        DateTime       @default(now()) @db.Timestamptz(6)
  atualizado_em                                       DateTime?      @default(now()) @db.Timestamptz(6)
  verificado                                          Boolean        @default(false)
  codigo_verificacao                                  Int?
  codigo_criacao_em                                   DateTime?      @db.Timestamptz(6)
  tentativas_login                                    Int            @default(0)
  tipo_usuario                                        tipo_usuario
  cursos                                              cursos         @relation(fields: [curso_id], references: [id])
}

enum periodo_enum {
  Manh_ @map("Manhã")
  Tarde
  Noite
}

enum tipo_usuario {
  Aluno
  Admin
}
